{
	"name": "@kouden/app",
	"private": true,
	"type": "module",
	"scripts": {
		"assets": "bun run css && bun scripts/copy-vendor.ts",
		"css": "tailwindcss -i src/styles/app.css -o public/assets/app.css --minify",
		"css:watch": "tailwindcss -i src/styles/app.css -o public/assets/app.css --watch=always",
		"dev": "bun run assets && (bun run css:watch & cf dev)",
		"serve": "bun run assets && cf dev",
		"build": "bun run assets && cf build",
		"deploy": "bun scripts/deploy.ts",
		"db:migrate:local": "bun scripts/d1-local-migrate.ts",
		"db:migrate": "bun scripts/d1-migrate.ts",
		"typegen": "cf workers types",
		"typecheck": "bun run typegen && tsc && tsc -p tsconfig.node.json",
		"test": "vitest run",
		"check:deploy": "bun scripts/check-deploy-settings.ts"
	},
	"dependencies": {
		"@kouden/domain": "workspace:*",
		"@kouden/ui": "workspace:*",
		"hono": "4.13.13",
		"jose": "6.2.12",
		"uqr": "0.1.3",
		"write-excel-file": "4.1.1"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-beta.sha-91c870c02",
		"@cloudflare/vitest-plugin": "1.4.0",
		"@tailwindcss/cli": "4.3.3",
		"@types/node": "22.20.5",
		"cf": "1.0.0-beta.14",
		"fflate": "0.8.3",
		"htmx.org": "2.0.11",
		"miniflare": "5.20261006.1-alpha",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.4"
	}
}
